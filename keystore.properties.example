# Copia este archivo a keystore.properties y rellena tus credenciales.
# keystore.properties está en .gitignore: NUNCA se sube al repositorio.
#
# Para generar el keystore (ver README, sección "Firma de release"):
#   keytool -genkeypair -v -keystore studylock-release.jks -alias studylock \
#     -keyalg RSA -keysize 4096 -validity 10000 -storetype PKCS12 \
#     -storepass <PASSWORD> -keypass <PASSWORD> \
#     -dname "CN=StudyLock UNJBG, OU=UNJBG, O=StudyLock, L=Tacna, ST=Tacna, C=PE"

storeFile=studylock-release.jks
storePassword=CAMBIA_ESTO
keyAlias=studylock
keyPassword=CAMBIA_ESTO
